# kraken-signal-bot configuration — copy to .env and fill in.
# NEVER commit .env. Placeholders only in this file.

# ---------------------------------------------------------------------------
# TRADING MODE — required, no default.
#   dry_run : parse + size + decide, never invokes the exchange at all
#   paper   : routes to `kraken futures paper` (simulated, live prices)
#   live    : REAL MONEY
# ---------------------------------------------------------------------------
TRADING_MODE=paper

# Live mode requires this SECOND, independent acknowledgement set to exactly
# I_UNDERSTAND_THIS_IS_REAL_MONEY. TRADING_MODE=live alone will refuse to start,
# so no single forgotten variable can send real orders.
LIVE_TRADING_ACK=

# ---------------------------------------------------------------------------
# Risk / sizing
# ---------------------------------------------------------------------------
TRADE_MARGIN_USD=30
# Leverage is FIXED at 10x for every trade (config.FIXED_LEVERAGE); the signal's
# own leverage (5x-75x) is logged and ignored. MAX_LEVERAGE is only a hard
# ceiling and must be >= 10. DEFAULT_LEVERAGE and MIN_LEVERAGE no longer exist.
MAX_LEVERAGE=10
MAX_ENTRY_DEVIATION_PERCENT=1.5
MAX_SIZING_DEVIATION_PERCENT=5.0
# Stop-vs-liquidation guard. At the fixed 10x, liquidation is estimated 8% from
# entry (2% maintenance rate, paper and live). A stop that would not trigger at
# least STOP_LIQ_BUFFER_PCT points before that (i.e. more than 7% from entry) is
# REFUSED as STOP_BEYOND_LIQUIDATION. Leverage is never lowered to fit a stop.
STOP_LIQ_BUFFER_PCT=1.0
ENTRY_ORDER_EXPIRY_HOURS=24
RECONCILIATION_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# GOLD / XAU
# PINNED OFF IN v1 — see docs/PLAN.md 4.4. Kraken has no spot-gold perpetual;
# the only candidate is PF_XAUTUSD (Tether Gold), whose price can drift from the
# spot XAU levels the signal channel quotes. Setting this true has NO effect in
# v1; it is refused at startup with a warning until the Stage 4 tracking study
# passes and BTC/ETH/SOL have run cleanly.
# ---------------------------------------------------------------------------
ALLOW_XAUT_FOR_GOLD=false

# ---------------------------------------------------------------------------
# Telegram (user account, not a bot account)
# Obtain api_id / api_hash from https://my.telegram.org
# ---------------------------------------------------------------------------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNEL=
TELEGRAM_SESSION_PATH=./secrets/telegram.session

# ---------------------------------------------------------------------------
# Kraken Futures credentials (required for live only; paper/dry need none).
# This is the key that trades. In the Kraken Futures UI set:
#     General API permissions    = Full Access   (excludes withdrawals)
#     Withdrawal API permissions = No Access
# ---------------------------------------------------------------------------
KRAKEN_FUTURES_API_KEY=
KRAKEN_FUTURES_API_SECRET=

# Kraken exposes NO read-only endpoint behind the futures Withdrawal API
# permission, so the bot cannot verify it without attempting a real withdrawal.
# It must therefore be attested. After confirming 'Withdrawal API = No Access'
# in the UI, set this to exactly: WITHDRAWAL_API_SET_TO_NO_ACCESS
# The claim is recorded in the audit log. See docs/KRAKEN_NOTES.md 1.4.
KRAKEN_FUTURES_WITHDRAWAL_ATTESTATION=

# Spot credentials are NOT needed for trading — leave blank unless you have a
# reason. If set, startup probes them for withdrawal capability. Note that a
# denial does not prove the key is safe (the endpoints need both 'Query Funds'
# and 'Withdraw Funds'), so a clean probe is reported as NOT_VERIFIABLE rather
# than as a pass. See docs/KRAKEN_NOTES.md 1.2.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
# Presence of this file halts NEW position opening. Existing positions continue
# to be managed and protected (stops, TPs, closes still run). See docs/PLAN.md.
KILL_SWITCH_PATH=./KILL_SWITCH
DB_PATH=./data/bot.db
LOG_PATH=./logs/bot.jsonl
LOG_LEVEL=INFO
KRAKEN_CLI_PATH=kraken
KRAKEN_CLI_TIMEOUT_SECONDS=30

# Optional dead-man's-switch (healthchecks.io style). The bot GETs this URL
# about every 3 minutes, but ONLY while a protection sweep (<=120s ago) and a
# reconciliation (<=300s ago) have both completed successfully. A hung or frozen
# bot goes silent and the monitor alerts. Leave blank to disable. Treat the URL
# as a secret; it is never logged.
HEALTHCHECK_URL=
